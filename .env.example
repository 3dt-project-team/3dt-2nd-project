# 로컬 개발용 환경 변수 템플릿
# 이 파일을 복사해 .env 를 만들고, 실제 값을 채운 후 az login 을 실행하세요.
# .env 파일은 .gitignore에 포함되어 있으므로 절대 커밋되지 않습니다.

# Azure Key Vault URL (필수)
KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/

# ADLS Gen2 계정 이름 (Key Vault에 adls-account-name 시크릿이 없을 때 사용)
ADLS_ACCOUNT_NAME=

# PostgreSQL 연결 타임아웃 (기본값: 5초)
PG_CONNECT_TIMEOUT_SECONDS=5

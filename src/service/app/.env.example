# SENSE RAG app local environment template
# Copy this file to .env inside src/service/app and fill in real values.
# This file is safe to commit. The real .env should stay local only.

# ------------------------------------------------------------------------------
# Optional: Azure Key Vault
# ------------------------------------------------------------------------------
# If KEY_VAULT_URL is set, this app loads secrets from Key Vault first
# (with .env values as fallback), using DefaultAzureCredential.
# Local development: run `az login` beforehand.
KEY_VAULT_URL=

# Optional: secret name overrides
SENSE_KV_PG_CONNECTION_SECRET_NAME=pg-connection-string
SENSE_KV_DB_HOST_SECRET_NAME=db-host
SENSE_KV_DB_PORT_SECRET_NAME=db-port
SENSE_KV_DB_NAME_SECRET_NAME=db-name
SENSE_KV_DB_USER_SECRET_NAME=db-user
SENSE_KV_DB_PASSWORD_SECRET_NAME=db-password
SENSE_KV_DB_SSLMODE_SECRET_NAME=db-sslmode
SENSE_KV_AOAI_API_KEY_SECRET_NAME=azure-openai-api-key
SENSE_KV_AOAI_ENDPOINT_SECRET_NAME=azure-openai-endpoint
SENSE_KV_AOAI_API_VERSION_SECRET_NAME=azure-openai-api-version
SENSE_KV_AOAI_CHAT_DEPLOYMENT_SECRET_NAME=azure-openai-chat-deployment
SENSE_KV_AOAI_EMBEDDING_DEPLOYMENT_SECRET_NAME=azure-openai-embedding-deployment

# ------------------------------------------------------------------------------
# Required: PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=your-postgres-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-user
DB_PASSWORD=your-password
DB_SSLMODE=require
PG_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# Required: Azure OpenAI
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ------------------------------------------------------------------------------
# Optional: Key Vault secret names
# Defaults in this app currently assume:
# - azure-openai-key
# - azure-openai-endpoint
# - pg-connection-string
# ------------------------------------------------------------------------------
KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
SENSE_KV_AOAI_API_KEY_SECRET_NAME=azure-openai-key
SENSE_KV_AOAI_ENDPOINT_SECRET_NAME=azure-openai-endpoint
SENSE_KV_PG_CONNECTION_SECRET_NAME=pg-connection-string

# ------------------------------------------------------------------------------
# Optional: default query behavior
# ------------------------------------------------------------------------------
SENSE_DEFAULT_STOCK_KEYWORD=SK HYNIX
SENSE_DEFAULT_STOCK_CODE=SK HYNIX
SENSE_DEFAULT_TICKER=000660.KS
SENSE_DEFAULT_NEWS_LIMIT=6
SENSE_DEFAULT_HISTORY_DAYS=7
SENSE_RERANK_POOL_MULTIPLIER=4
SENSE_ANSWER_TEMPERATURE=0.2
SENSE_DEFAULT_HORIZON_DAY=5
